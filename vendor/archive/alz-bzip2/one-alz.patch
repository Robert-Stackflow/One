+/* One: ALZ's DLZ framing has no bzip2 CRC; caller MUST verify entry CRC32. */
+int BZ_API(BZ2_alzDecompressInit) (bz_stream* strm) {
+   int result = BZ2_bzDecompressInit(strm, 0, 0);
+   if (result == BZ_OK) {
+      ((DState*)strm->state)->alz = True;
+      ((DState*)strm->state)->state = BZ_X_ALZ_START;
+   }
+   return result;
+}
