+// One: level 3 has a bounded full header and 32-bit extension sizes.
+static HRESULT ReadLevel3(ISequentialInStream *stream, const Byte *start,
+    const Byte *basic, CItem &item)
+{
+  if (Get16(start) != 4)
+    return S_FALSE;
+  Byte extra[8];
+  RINOK(ReadStream_FALSE(stream, extra, sizeof(extra)))
+  const UInt32 size = Get32(extra);
+  if (size < 32 || size > (1u << 20))
+    return S_FALSE;
+  CByteBuffer raw;
+  raw.Alloc(size);
+  Byte *data = (Byte *)raw;
+  memcpy(data, start, 2);
+  memcpy(data + 2, basic, kBasicPartSize);
+  memcpy(data + 24, extra, 8);
+  RINOK(ReadStream_FALSE(stream, data + 32, size - 32))
+  item.CRC = Get16(data + 21);
+  item.OsId = data[23];
+  UInt32 offset = 28;
+  bool hasCrc = false;
+  UInt16 headerCrc = 0;
+  for (;;)
+  {
+    if (offset > size - 4)
+      return S_FALSE;
+    const UInt32 length = Get32(data + offset);
+    if (length == 0)
+      break;
+    if (length < 5 || length > size - offset - 4
+        || item.Extensions.Size() >= (1 << 8))
+      return S_FALSE;
+    CExtension ext;
+    ext.Type = data[offset + 4];
+    const UInt32 dataSize = length - 5;
+    ext.Data.Alloc(dataSize);
+    if (dataSize)
+      memcpy((Byte *)ext.Data, data + offset + 5, dataSize);
+    if (ext.Type == 0)
+    {
+      if (hasCrc || dataSize < 2)
+        return S_FALSE;
+      hasCrc = true;
+      headerCrc = Get16(data + offset + 5);
+      data[offset + 5] = data[offset + 6] = 0;
+    }
+    item.Extensions.Add(ext);
+    offset += length;
+  }
+  if (hasCrc && LzhCrc16Update(0, data, size) != headerCrc)
+    return S_FALSE;
+  return S_OK;
 }
 
